#
# Fires bebop-mail-relay-retry.service every 15 minutes. Persistent=true
# means a missed run (VDS was down, service was masked) catches up on
# next boot instead of waiting for the next scheduled tick.

[Unit]
Description=Periodic upstream declaration sweep for the mail-relay
Documentation=https://be-bop.io/

[Timer]
OnBootSec=5min
OnUnitActiveSec=15min
Persistent=true
Unit=bebop-mail-relay-retry.service

[Install]
WantedBy=timers.target
