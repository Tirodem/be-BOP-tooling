#
# Template unit for a single per-tenant local mongod instance.
# Instantiate as:  systemctl enable --now mongod@<tenant>.service
#
# Per-instance prerequisites populated by add-tenant.sh:
#   /etc/be-BOP-mongodb/<tenant>/port.env   root:root 0640
#       Must define MONGO_PORT=<port> (e.g. 27018, 27019, …)
#       May define MONGO_AUTH_ARGS to activate authentication:
#           MONGO_AUTH_ARGS=--auth --keyFile /run/credentials/mongod@<tenant>.service/keyfile
#       When empty (default) mongod runs WITHOUT auth — historical
#       behaviour, kept for tenants that haven't yet been migrated by
#       migrate-mongo-auth.sh.
#
# State (WiredTiger files, journal, replica set metadata) is auto-created by
# mongod on first start under /var/lib/be-BOP-mongodb/<tenant>/, owned by the
# DynamicUser. Each instance is a single-node replica set named rs0.
#
# Auth model (when MONGO_AUTH_ARGS is set): --keyFile enables intra-cluster
# auth (required by mongod as soon as --auth is on for a replSet), the
# keyfile itself is a host-wide /etc/be-BOP-mongodb/keyfile generated by
# host-bootstrap.sh, delivered to the DynamicUser via LoadCredential=
# into a private tmpfs at /run/credentials/mongod@<tenant>.service/keyfile.
# One SCRAM user per tenant is created on the tenant's own DB with role
# dbOwner scoped to that DB only (see lib/mongo.sh + add-tenant.sh).

[Unit]
Description=MongoDB Database Server (%i)
Documentation=https://docs.mongodb.com/manual/
After=network.target
Wants=network.target

[Service]
Type=simple
DynamicUser=yes
StateDirectory=be-BOP-mongodb/%i
StateDirectoryMode=0700
EnvironmentFile=/etc/be-BOP-mongodb/%i/port.env
# Host-wide keyfile delivered to the DynamicUser via LoadCredential.
# The actual keyfile perms MUST be 0400/0600 owned by root on disk;
# LoadCredential copies it into a private tmpfs (0400 owned by the
# service's runtime user) so DynamicUser can read it without ever
# seeing the source path. When MONGO_AUTH_ARGS is empty, mongod ignores
# the credential file — no side effect.
LoadCredential=keyfile:/etc/be-BOP-mongodb/keyfile

# --wiredTigerCacheSizeGB is MANDATORY here, and 1 GiB is not a tuning
# preference — it is what keeps the host alive.
#
# Left unset, WiredTiger sizes its cache at 50% of (host RAM - 1 GiB) and
# each instance does that arithmetic on its own, blind to its siblings.
# With one mongod per tenant that is a guaranteed oversubscription: on a
# 24 GiB host every instance believes it may take ~11.5 GiB. They coexist
# only because the cache fills lazily.
#
# It caught up with us on 2026-09-23 with 18 tenants: 19 mongod holding
# 18.2 GiB of the 23.4 GiB in use (node: 4.5, phoenixd: 0.7), four of them
# between 0.9 and 2.5 GiB against a 0.53 GiB median — a reporting query on
# one tenant pulling its working set into an unbounded cache. The kernel
# OOM-killed mongod@sandbox, then a second instance seven minutes later,
# and the host went unreachable.
#
# Note this bounds the CACHE, not the RSS: expect ~1.4-1.8 GiB resident
# per instance at this setting. Use MemoryHigh=/MemoryMax= for a hard
# bound on the process.
#
# Per-tenant override, when one tenant genuinely needs more:
#   /etc/systemd/system/mongod@<tenant>.service.d/cache.conf
#     [Service]
#     ExecStart=
#     ExecStart=/usr/bin/mongod ... --wiredTigerCacheSizeGB 2 ...
#
# NOTE: ExecStart below uses bare $MONGO_AUTH_ARGS (no braces) so systemd
# whitespace-SPLITS the value into distinct argv elements. With
# ${MONGO_AUTH_ARGS} (braces), the whole "--auth --keyFile /..." string
# is passed to mongod as ONE argument and mongod exits code 2 with
# "unknown option". See systemd.exec(5) "variable substitution".
ExecStart=/usr/bin/mongod \
    --dbpath /var/lib/be-BOP-mongodb/%i \
    --bind_ip 127.0.0.1 \
    --port ${MONGO_PORT} \
    --replSet rs0 \
    --wiredTigerCacheSizeGB 1 \
    --logpath /var/lib/be-BOP-mongodb/%i/mongod.log \
    --logappend \
    $MONGO_AUTH_ARGS
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=60
LimitNOFILE=65536
LimitMEMLOCK=infinity
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mongod-%i

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
