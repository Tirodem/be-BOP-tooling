#
# Host-wide deploy defaults for new tenants (fresh add-tenant path).
# Install at /etc/be-BOP-tooling/deploy-default.env with mode 0644 owned by root.
#
# NOT SECRET — reviewable ops configuration. Kept separate from
# secrets.env so it can have relaxed perms and be tracked/reviewed
# without exposing credentials.
#
# Loaded by: add-tenant.sh (fresh path only). Existing tenants keep
# their original setup on reapply / reactivate; no migration.
#
# Applies uniformly whether add-tenant.sh is called manually on the CLI
# or spawned by tooling-tenant-api.service (deploy webhook).
#
# CLI flags on add-tenant.sh (--phoenixd/--no-phoenixd, --local-s3/
# --no-local-s3, --mail-relay/--no-mail-relay) OVERRIDE these defaults
# per-invocation.
#
# All 3 knobs default to "true" (full stack) if unset — matches the
# pre-refactor behaviour, safe for hosts that haven't been reviewed yet.

# === Feature knobs ===

# Provision a per-tenant phoenixd daemon (Lightning wallet + REST API)?
# false = no --phoenixd systemd unit, no seed.dat, tenant runs without
# a Lightning capability. Use on merchants that don't accept BTC/LN.
BEBOP_TENANT_DEFAULT_PHOENIXD="true"

# Provision a per-tenant Garage bucket + S3 key (local S3-compatible
# storage under s3.<tid>.<zone>)?
# false = no Garage bucket, no s3.<tid> DNS record, no separate S3 cert.
# The tenant's be-BOP starts with empty S3 env vars — the merchant
# configures external S3 (AWS, Backblaze, etc.) via the be-BOP UI.
BEBOP_TENANT_DEFAULT_LOCAL_S3="true"

# Provision the tenant's mail-relay row (fake SMTP shim → upstream
# transactional provider, e.g. Scaleway TEM)?
# false = no mail-relay row, no runtimeConfig.smtp injection. The
# tenant's be-BOP has no outbound SMTP capability — order emails
# / password resets / etc. silently no-op. Use on merchants that
# don't need transactional mail (rare) or on minimal test hosts.
BEBOP_TENANT_DEFAULT_MAIL_RELAY="true"
