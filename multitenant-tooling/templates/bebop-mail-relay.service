#
# Fake SMTP relay: accepts SMTP AUTH connections from each be-BOP tenant on
# this host (127.0.0.1:2525 STARTTLS), rate-limits per-tenant, then forwards
# to the transactional provider (Scaleway TEM in V1). Provider-agnostic by
# design: swap the outbound side without changing anything tenant-side.
#
# State (tenants creds + send_log + alert_state) lives in mongod@tooling on
# 127.0.0.1:27100 (dedicated tooling instance provisioned by
# host-bootstrap step_setup_tooling_mongodb). ExecStartPre guarantees the
# instance is up + replica-set-initialised before the daemon starts.

[Unit]
Description=be-BOP — mail relay (fake SMTP shim, forwards to transactional provider)
Documentation=https://be-bop.io/
After=network-online.target mongod@tooling.service
Wants=network-online.target mongod@tooling.service

[Service]
Type=simple
DynamicUser=yes
EnvironmentFile=/etc/be-BOP-tooling/secrets.env
EnvironmentFile=-/etc/be-BOP-tooling/mail-relay.env
ExecStartPre=+/usr/local/bin/bebop-mail-relay-preflight.sh
ExecStart=/usr/bin/python3 /usr/local/share/be-BOP-tooling/lib/mail-relay.py
Restart=always
RestartSec=5
TimeoutStartSec=30
TimeoutStopSec=15

StandardOutput=journal
StandardError=journal
SyslogIdentifier=bebop-mail-relay

# Hardening — the daemon only needs its state dir + network out, no privileges.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
