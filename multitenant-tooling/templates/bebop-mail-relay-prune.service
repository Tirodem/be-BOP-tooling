#
# Nightly prune of the mail-relay send_log. Rows older than 90 days are
# deleted — enough to keep 3 months of audit trail while stopping the
# tooling MongoDB from growing unboundedly. The 30-day sliding-month counter
# window is well within retention.

[Unit]
Description=be-BOP — nightly prune of the mail-relay send_log
Documentation=https://be-bop.io/
After=bebop-mail-relay.service
Wants=bebop-mail-relay.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/mail-relay-ctl.sh prune-send-log --older-than-days=90
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bebop-mail-relay-prune
