#
# Reaper cadence: every 5 minutes. Persistent=true so a missed run during
# downtime fires once on boot (we still want expired test tenants gone).

[Unit]
Description=be-BOP — fire the test-tenant reaper every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s
Persistent=true
Unit=tooling-tenant-reaper.service

[Install]
WantedBy=timers.target
