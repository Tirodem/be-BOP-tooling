#
# Template unit for a single be-BOP tenant.
# Instantiate as:  systemctl enable --now bebop@<tenant>.service
#
# Per-instance prerequisites populated by add-tenant.sh:
#   /var/lib/be-BOP/<tenant>/                   root:root 0755 (created by tooling)
#   /var/lib/be-BOP/<tenant>/releases/<tag>/    root:root 0755 (release artefact)
#   /var/lib/be-BOP/<tenant>/releases/current   symlink → <tag>
#   /etc/be-BOP/<tenant>/config.env             root:root 0640 (per-tenant env)
#
# /var/lib/be-BOP/<tenant>/state/ is created on first start by systemd via
# StateDirectory=, and owned by the dynamic user. This is where pnpm caches
# and any future runtime data live; the release tree above stays read-only.

[Unit]
Description=be-BOP Application Server (%i)
Documentation=https://github.com/be-BOP-io-SA/be-BOP
Requires=mongod@%i.service
After=network-online.target garage.service mongod@%i.service phoenixd@%i.service
Wants=network-online.target garage.service phoenixd@%i.service

[Service]
Type=simple
DynamicUser=yes
StateDirectory=be-BOP/%i/state
StateDirectoryMode=0700
WorkingDirectory=/var/lib/be-BOP/%i/releases/current
Environment=HOME=/var/lib/be-BOP/%i/state
Environment=NODE_ENV=production
EnvironmentFile=/etc/be-BOP/%i/config.env
# Guarantees mongod@<tenant> is up AND its rs0 replica set is initialised
# BEFORE node starts. The '+' prefix runs the hook as real root (bypassing
# DynamicUser). Failure here blocks the start on purpose — a bebop without
# a primary-elected mongo just hits 30s Mongo timeouts and exits.
ExecStartPre=+/usr/local/bin/bebop-mongo-preflight.sh %i
ExecStart=/usr/bin/node build/index.js
# Exit-code protocol v1 (contract be-BOP ↔ orchestrator validated 2026-06-12).
# be-BOP signals intent to the orchestrator via specific exit codes:
#   0        permanent shutdown (do NOT restart)
#   100      restart on same version
#   101      update to latest GitHub release
#   110-119  rollback to N-k (k = code - 109)
# Restart=on-failure honors "0 = stop permanently" by default. Codes 100/
# 101/110-119 are marked as clean via SuccessExitStatus= (no journal noise).
# Only code 100 (restart same version) is force-restarted by systemd —
# for 101 (update-latest) and 110-119 (rollback), bebop-exit-handler.sh
# spawns bebop-exit-worker.sh via `systemd-run --no-block` which does the
# heavy download+swap OUTSIDE TimeoutStopSec, then re-starts bebop@ itself.
Restart=on-failure
SuccessExitStatus=100 101 110 111 112 113 114 115 116 117 118 119
RestartForceExitStatus=100
ExecStopPost=+/usr/local/bin/bebop-exit-handler.sh %i
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
LimitNOFILE=65536
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bebop-%i

# Hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictNamespaces=yes
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
