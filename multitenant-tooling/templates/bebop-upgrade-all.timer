#
# bebop-upgrade-all.timer — daily trigger for bebop-upgrade-all.service.
#   - OnCalendar 04:00 server time (per-tenant rollback handled by
#     upgrade-tenant.sh; --continue-on-failure prevents one bad tenant
#     from blocking the rest).
#   - Persistent=true catches up if the VDS was down at 04:00.
#   - RandomizedDelaySec spreads start across 15 min — useful when several
#     VDS share upstream GitHub API quotas or downstream notification
#     endpoints.

[Unit]
Description=Daily be-BOP fleet upgrade at 04:00

[Timer]
OnCalendar=*-*-* 04:00:00
RandomizedDelaySec=15min
Persistent=true

[Install]
WantedBy=timers.target
