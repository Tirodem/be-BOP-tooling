#
# Daily at 03:00 UTC. Persistent=true so a missed run on a stopped VDS
# catches up on next boot. 30 min after tooling-backup-tenants so the
# per-tenant dumps have already landed.

[Unit]
Description=be-BOP nightly backup — host-level tooling state
Documentation=https://be-bop.io/

[Timer]
OnCalendar=*-*-* 03:00:00 UTC
Persistent=true
Unit=tooling-backup-tooling.service

[Install]
WantedBy=timers.target
