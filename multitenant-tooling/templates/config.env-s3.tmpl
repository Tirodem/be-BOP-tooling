# --- S3 / Garage section ----------------------------------------------------
# This fragment is appended to config.env-main.tmpl by add-tenant.sh ONLY when
# the tenant has a local Garage bucket. Under --no-local-s3 this block is
# omitted entirely (no env vars at all for S3), so be-BOP falls back to its
# UI / database configuration — the merchant supplies their own external S3.
#
# Substitution placeholders (replaced by add-tenant.sh):
#   @s3_domain@                 s3.<tenant>.<zone>             (public S3 host)
#   @garage_bucket@             per-tenant bucket (bebop-<tenant>)
#   @garage_key_id@             access key id
#   @garage_key_secret@         access key secret

S3_REGION=garage
S3_ENDPOINT_URL=http://127.0.0.1:3900
PUBLIC_S3_ENDPOINT_URL=https://@s3_domain@
S3_BUCKET=@garage_bucket@
S3_KEY_ID=@garage_key_id@
S3_KEY_SECRET=@garage_key_secret@
