#
# Periodic sweep that declares tenants' sending domains upstream (i.e.
# with whichever transactional provider is configured — Scaleway TEM in
# V1). Scans the mail-relay's tooling MongoDB for docs with upstream_domain_id IS
# NULL and delegates each to lib/scaleway.sh's mail_upstream_setup_domain.
# Silent no-op if the operator hasn't provided upstream credentials — the
# fake SMTP runs standalone whether upstream is configured or not.

[Unit]
Description=be-BOP — mail-relay upstream declaration sweep
Documentation=https://be-bop.io/
After=network-online.target tooling-mail-relay.service
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/be-BOP-tooling/secrets.env
ExecStart=/usr/local/bin/mail-relay-ctl.sh retry-upstream --all
StandardOutput=journal
StandardError=journal
SyslogIdentifier=tooling-mail-relay-retry
