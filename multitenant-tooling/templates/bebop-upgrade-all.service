#
# bebop-upgrade-all.service — fleet-wide be-BOP upgrade run, invoked by
# bebop-upgrade-all.timer. Default schedule: daily at 04:00 server time.
# Installed (and toggled enable/disable) by host-bootstrap.sh based on
# BEBOP_NIGHTLY_UPGRADE_ENABLED in /etc/be-BOP-tooling/secrets.env.

[Unit]
Description=be-BOP fleet upgrade (all active tenants)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/upgrade-all.sh --continue-on-failure --non-interactive
SyslogIdentifier=bebop-tooling-upgrade-all-cron
