#
# Per-tenant be-BOP application config (MAIN fragment) — managed by the
# multi-tenant tooling. Always rendered. The S3 / Garage section lives in
# config.env-s3.tmpl and is appended by add-tenant.sh ONLY when the
# tenant has a local Garage bucket (default; omitted under --no-local-s3,
# in which case S3 is configured by the merchant via the be-BOP UI).
#
# The scissor marker (>8) is NOT in this fragment — add-tenant.sh appends
# it (and any preserved operator customisations below it) AFTER all the
# fragments have been concatenated.
#
# tooling-fingerprint: @template_revision@
#
# Substitution placeholders (all replaced by add-tenant.sh):
#   @bebop_port@                local be-BOP port
#   @domain@                    public host (internal: <tenant>.<zone>; external: --external-domain)
#   @mongodb_url@               mongodb://127.0.0.1:<mongo_port>/bebop_<t>?replicaSet=rs0
#   @mongodb_database@          per-tenant DB name (bebop_<tenant>)
#   @phoenixd_port@             local phoenixd HTTP port
#   @phoenixd_http_password@    phoenixd HTTP password (read from phoenix.conf)
#   @template_revision@         template fingerprint

ADDRESS_HEADER=X-Forwarded-For
PORT=@bebop_port@
ORIGIN=https://@domain@
XFF_DEPTH=1

# === MongoDB (local, per-tenant mongod on 127.0.0.1) ===
MONGODB_URL=@mongodb_url@
MONGODB_DB=@mongodb_database@

# === Phoenixd (Lightning) ===
PHOENIXD_ENDPOINT_URL=http://127.0.0.1:@phoenixd_port@
PHOENIXD_HTTP_PASSWORD=@phoenixd_http_password@
