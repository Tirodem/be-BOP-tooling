#
# Global secrets for be-BOP multi-tenant tooling.
# Install at /etc/be-BOP-tooling/secrets.env with mode 0600 owned by root.
#
# Loaded by: host-bootstrap.sh, add-tenant.sh, remove-tenant.sh, upgrade-*.sh
# Never log raw values — see lib/log.sh:mask_secrets.
#
# Quoting convention: every value is wrapped in double quotes "" so that
# special characters (apostrophes, spaces, $, !, etc. in passwords) do not
# break `source secrets.env`. If your value itself contains a literal " ,
# escape it as \" inside the surrounding double quotes.

# === DNS provider ===
# Selects which lib/<provider>.sh backs the provider-agnostic
# dns_provider_* API used by add-tenant.sh, remove-tenant.sh, the certbot
# DNS-01 hooks, and mail-relay-ctl retry-upstream. Currently supported:
#     ovh, infomaniak
# Empty here → host-bootstrap.sh refuses to start (no silent OVH default).
# Fill explicitly with the value matching your ops choice.
DNS_PROVIDER=""

# DNS zone hosting the tenant sub-domains (e.g. be-bop.dev, be-bop.dev).
# Provider-agnostic; both OVH and Infomaniak backends read this.
BEBOP_DNS_ZONE=""

# Additional (zone, provider) pairs used ONLY for cert renewal, when the
# fleet still hosts certs whose domains live in a zone that is no longer
# the canonical one (typical after a provider migration).
# Format: space-separated "zone:provider" pairs, e.g.
#     BEBOP_DNS_EXTRA_ZONES="pvh-labs.com:ovh legacy.example.net:ovh"
# The DNS-01 hook picks the longest-suffix match at renewal time and dies
# only if NO zone matches. Provider creds for each declared provider must
# still be present below. Leave empty when the fleet only serves domains
# under BEBOP_DNS_ZONE.
BEBOP_DNS_EXTRA_ZONES=""

# --- OVH ------------------------------------------------------------------
# Required when DNS_PROVIDER=ovh. Generate at:
#     https://eu.api.ovh.com/createToken/
# Required scopes — strictly limited to the DNS zone configured above;
# the tooling never touches anything outside it. Replace <zone> below
# with your BEBOP_DNS_ZONE value.
#     GET     /me
#     GET     /domain/zone/<zone>/*
#     POST    /domain/zone/<zone>/*
#     DELETE  /domain/zone/<zone>/*
OVH_APPLICATION_KEY=""
OVH_APPLICATION_SECRET=""
OVH_CONSUMER_KEY=""

# --- Infomaniak -----------------------------------------------------------
# Required when DNS_PROVIDER=infomaniak. Generate a Personal Access Token
# (product = Domain / DNS) at:
#     https://manager.infomaniak.com/v3/ng/accounts/token/list
INFOMANIAK_API_TOKEN=""

# Single Let's Encrypt operator account email shared across all tenants.
# Without this, add-tenant.sh falls back to the per-tenant --admin-email,
# which makes certbot register a NEW LE account for every tenant —
# Let's Encrypt rate-limits at "10 accounts / IP / 3h", so bulk
# onboarding (>10 tenants in 3h) hits a hard wall. Setting this once
# for the whole fleet keeps every cert under the same LE account and
# eliminates that risk.
LE_OPERATOR_EMAIL=""

# Opt-in test flag — leave commented out on any host serving real
# tenants. Uncomment + set to "true" to have add-tenant.sh issue certs
# against the Let's Encrypt STAGING endpoint (untrusted by browsers).
# Meant for repeated test provisionings — prod LE rate-limits at "5
# duplicate certs per exact identifier set per 168h" and a purge+recreate
# loop burns through that fast. Overridable per-invocation via
# `add-tenant.sh <tid> --staging` (no need to touch this file just for
# a one-off test).
#BEBOP_LE_STAGING="true"

# Note: MongoDB is now hosted locally per-tenant (one mongod per tenant on
# 127.0.0.1, see templates/mongod@.service). No external Mongo configuration
# is required.

# === SFTP backup destination ===
# Used by remove-tenant.sh --archive to upload encrypted tenant archives.
SFTP_HOST=""
SFTP_PORT="22"
SFTP_USER=""
# Either a literal password or an absolute path to an SSH private key.
# Prefer a key path on production hosts.
SFTP_PASSWORD_OR_KEY_PATH=""
SFTP_REMOTE_PATH=""

# Symmetric key used to encrypt archive bundles before SFTP upload.
# Generate with: openssl rand -hex 32
BACKUP_ENCRYPTION_KEY=""

# === SMTP notifications ===
# Used to alert the support team on failed mutations (add/remove/upgrade).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_TO=""

# === Zulip notifications ===
# Bot credentials for posting alerts and success notices to a stream.
ZULIP_SITE=""
ZULIP_BOT_EMAIL=""
ZULIP_BOT_API_KEY=""
ZULIP_STREAM=""
ZULIP_TOPIC=""

# === Uptime Kuma ===
# Kuma runs locally in Docker on the same VDS (127.0.0.1:8810 by default)
# and is fully managed by the tooling: host-bootstrap.sh auto-provisions
# the admin (creds saved to /etc/be-BOP-tooling/kuma-admin.env, mode 0600),
# wires the SMTP + Zulip notification channels from this file, and
# add-tenant.sh / remove-tenant.sh add/remove monitors via Socket.IO.
# Override only if you changed UPTIME_KUMA_HOST_PORT in host-bootstrap.sh.
UPTIME_KUMA_URL="http://localhost:8810"

# === Netdata public access (optional) ===
# Set this to expose the Netdata UI publicly at the given hostname,
# behind nginx + Let's Encrypt + HTTP basic auth. The hostname must
# resolve under BEBOP_DNS_ZONE (host-bootstrap.sh creates the A record
# automatically via the configured DNS provider). The auto-generated admin password
# is stored at /etc/be-BOP-tooling/netdata-admin.env (mode 0600).
# Leave empty to keep Netdata local-only (SSH tunnel for access).
# Recommended value: netdata.be-bop.dev
NETDATA_PUBLIC_HOSTNAME=""

# Set this to expose the Uptime Kuma UI publicly at the given hostname,
# behind nginx + Let's Encrypt. Kuma has its own auth (admin login auto-
# generated by host-bootstrap.sh, see /etc/be-BOP-tooling/kuma-admin.env)
# so no extra basic-auth layer is added. The hostname must resolve under
# BEBOP_DNS_ZONE. Leave empty to keep Kuma local-only (SSH tunnel).
# Recommended value: kuma.be-bop.dev
KUMA_PUBLIC_HOSTNAME=""

# === be-BOP branch deploys (tenant-cli release install branch=...) ===
# Fine-grained GitHub PAT used by tenant-cli.sh to download branch builds
# from the be-BOP CI via the GitHub Actions API. Required scopes (on
# be-BOP-io-SA/be-BOP only):
#     Repository permissions:
#         Actions   = Read-only
#         Contents  = Read-only
#         Metadata  = Read-only (auto-required by GitHub)
# Generate at https://github.com/settings/personal-access-tokens/new
# (Fine-grained tokens > Repository access > "Only select repositories"
# > be-BOP-io-SA/be-BOP). Leave empty if you only deploy tagged releases
# from public GitHub releases (no auth needed for those).
BEBOP_GITHUB_PAT=""

# === Test-tenant deploy API (optional) ===
# When BEBOP_DEPLOY_API_ENABLED=true, host-bootstrap.sh installs an HTTP
# daemon (loopback-bound on 127.0.0.1:8820 by default) that accepts paid-
# order webhooks from a be-BOP "spawn a test tenant" shop and spins up an
# ephemeral test tenant on this host.
#
# Two exposure modes:
#   1. Local only (default when ENABLED=true, HOSTNAME empty)
#        - Daemon + reaper are installed; no DNS / no cert / no nginx vhost.
#        - The calling be-BOP MUST run on this same VDS and target
#          http://127.0.0.1:8820/deploy-test-tenant in its webhook settings.
#        - Auth still relies on HMAC-SHA256 (BEBOP_DEPLOY_API_SECRET).
#   2. Public (HOSTNAME set)
#        - Adds DNS A record + DNS-01 Let's Encrypt cert + nginx vhost +
#          source-IP whitelist (see BEBOP_DEPLOY_API_ALLOWED_IPS below).
#        - The webhook URL becomes https://<HOSTNAME>/deploy-test-tenant.
#
# Auth: HMAC-SHA256 over the raw request body, sent by be-BOP in
# `X-Webhook-Signature: sha256=<hex>`. BEBOP_DEPLOY_API_SECRET below must
# match the secret configured in the calling be-BOP's webhook settings.
# Leave empty to have host-bootstrap.sh auto-generate one into
# /etc/be-BOP-tooling/deploy-api.env (mode 0600).
#
# Lifecycle: every test tenant is auto-purged after
# BEBOP_TEST_TENANT_TTL_SECONDS (default 7200 = 2h) by the reaper timer.
#
# Replay-protection: requests whose JSON `timestamp` field is older than
# BEBOP_DEPLOY_API_REPLAY_WINDOW_SECONDS (default 300 = 5 min) are rejected.
#
# Allowed source IPs (PUBLIC MODE ONLY — nginx `allow` / `deny all`):
# empty value means the host's loopback + the auto-detected VDS public IP
# (works for be-BOPs deployed on the same VDS — the kernel may route through
# `lo` or `eth0` depending on its routing table, so both are whitelisted).
# Set a comma-separated list to override (CIDRs accepted, e.g.
# "127.0.0.1,203.0.113.4,10.0.0.0/24"). Ignored in local-only mode.
BEBOP_DEPLOY_API_ENABLED=""
BEBOP_DEPLOY_API_HOSTNAME=""
BEBOP_DEPLOY_API_SECRET=""
BEBOP_DEPLOY_API_REPLAY_WINDOW_SECONDS="300"
BEBOP_DEPLOY_API_ALLOWED_IPS=""
BEBOP_TEST_TENANT_TTL_SECONDS="7200"
BEBOP_TEST_TENANT_BRANCH="main"

# === Nightly fleet upgrade (optional) ===
# When set to "true", host-bootstrap.sh enables tooling-upgrade-all.timer,
# which runs `upgrade-all.sh --continue-on-failure --non-interactive` daily
# at 04:00 server time (Persistent=true, so a missed run catches up at next
# boot). Leave empty / "false" to keep the timer disabled. Toggling this
# value and re-running host-bootstrap.sh (or install.sh) is the supported
# way to turn nightly upgrades on/off.
BEBOP_NIGHTLY_UPGRADE_ENABLED=""

# === Nightly backups (optional) ===
# When set to "true", host-bootstrap.sh enables:
#   - tooling-backup-tenants.timer → 02:30 UTC daily, dumps every active
#     tenant (mongo + files + Garage bucket) via backup-tenants.sh --all.
#   - tooling-backup-tooling.timer → 03:00 UTC daily, snapshots host-level
#     state (registry, deploy-default.json, secrets sidecars, mail-relay
#     DB) via backup-tooling.sh. Runs AFTER the tenants timer.
# Both use Persistent=true so a missed run on a stopped VDS catches up
# on next boot. Backup destinations + retention are configured on the
# scripts themselves (SFTP offsite via BEBOP_BACKUP_SFTP_* — separate
# section below when you set those). Leave empty / "false" to keep the
# timers installed but disabled; toggling this value and re-running
# host-bootstrap.sh is the supported switch.
BEBOP_NIGHTLY_BACKUP_ENABLED=""

# === Upstream provider — API credentials ===
# The mail-relay is a fake SMTP shim that works standalone regardless
# of whether an upstream provider is configured. Filling the values
# below opts in to a real delivery path: tooling-mail-relay-upstream-sync
# (systemd timer, every 15 min) sees a configured provider and declares
# each tenant's sending domain against it.
#
# Currently the only supported adapter is Scaleway TEM (fr-par). Adding
# another provider means adding a lib/<provider>.sh with the same
# mail_upstream_* API and switching the source line in
# mail-relay-ctl.sh's cmd_retry_upstream.
#
# Scaleway TEM specifics — used only by lib/scaleway.sh:
SCALEWAY_TEM_API_KEY=""
SCALEWAY_TEM_PROJECT_ID=""
SCALEWAY_TEM_REGION="fr-par"

# === mail-relay upstream provider (transactional SMTP) ===
# The fake SMTP shim (tooling-mail-relay.service) forwards each tenant's
# outbound mail to this upstream provider. V1 targets Scaleway TEM but
# any SMTP-speaking transactional service works — swap host/port/user/
# password and restart tooling-mail-relay.
#
# Leave these empty to run the relay in "accept + log only, no forward"
# mode (useful in dev before provider onboarding is done). Tenants can
# still AUTH and their sends are logged in the relay SQLite; nothing
# actually leaves the machine.
MAIL_RELAY_UPSTREAM_HOST=""
MAIL_RELAY_UPSTREAM_PORT="587"
MAIL_RELAY_UPSTREAM_USER=""
MAIL_RELAY_UPSTREAM_PASSWORD=""
# Set to "true" to use SMTPS (implicit TLS on port 465). Default "false"
# means STARTTLS on submission port (587), which is what Scaleway TEM
# expects. Any lower-case truthy string is accepted (true/1/yes/on).
MAIL_RELAY_UPSTREAM_SMTPS=""
